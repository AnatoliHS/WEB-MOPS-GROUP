<nav class="navbar" id="navbar">
  <div class="nav-inner">
    <a href="#hero" class="nav-brand" aria-label="{{ site.name }} Home">
      <div class="nav-logo-wrap">
        <img class="nav-logo logo-general active" src="/assets/mops-group-general.png" alt="MOPS Group Logo" loading="eager">
        <img class="nav-logo logo-restoration" src="/assets/mops-group-resoration.png" alt="MOPS Group Restoration Logo" loading="lazy">
        <img class="nav-logo logo-janitorial" src="/assets/mops-group-janitorial.png" alt="MOPS Group Janitorial Logo" loading="lazy">
      </div>
    </a>

    <div class="nav-links" id="nav-links">
      <div class="nav-menu">
        <a href="#hero" class="nav-link">Home</a>
        <a href="#services" class="nav-link">Services</a>
        <a href="#process" class="nav-link">Capabilities</a>
        <a href="#trust" class="nav-link">Certifications</a>
        <a href="#janitorial-services-section" class="nav-link">Janitorial</a>
        <a href="#rentals" class="nav-link">Rentals</a>
        <a href="#reviews" class="nav-link">Reviews</a>
        <a href="#faq" class="nav-link">FAQ</a>
      </div>
      <a href="#contact" class="nav-cta">Get Emergency Help</a>
    </div>

    <button class="mobile-toggle" id="mobile-toggle" onclick="toggleMenu()" aria-label="Toggle menu" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</nav>

<script>
  /* ─── Navbar scroll state & dynamic logo swapper ─── */
  (function() {
    const navbar = document.getElementById('navbar');
    const logoGeneral = document.querySelector('.nav-logo.logo-general');
    const logoRestoration = document.querySelector('.nav-logo.logo-restoration');
    const logoJanitorial = document.querySelector('.nav-logo.logo-janitorial');

    function updateNavbar() {
      if (!navbar) return;
      const scrollY = window.scrollY;

      // Scrolled class state
      navbar.classList.toggle('scrolled', scrollY > 60);

      const heroSection = document.getElementById('hero');
      const janitorialSection = document.getElementById('janitorial-services-section');

      if (!heroSection || !janitorialSection) return;

      const heroHeight = heroSection.offsetHeight;
      const jTop = janitorialSection.offsetTop;
      const jHeight = janitorialSection.offsetHeight;

      // Determine active logo type based on position
      let activeLogo = 'general';

      if (scrollY <= heroHeight - 72) {
        // In the hero section
        activeLogo = 'general';
      } else if (scrollY < jTop - 80) {
        // In mitigation / core services
        activeLogo = 'restoration';
      } else if (scrollY < jTop + jHeight - 80) {
        // In Janitorial services
        activeLogo = 'janitorial';
      } else {
        // Everything after Janitorial (Rentals, Reviews, FAQ, Footer)
        activeLogo = 'general';
      }

      // Apply active classes to logos
      if (logoGeneral) logoGeneral.classList.toggle('active', activeLogo === 'general');
      if (logoRestoration) logoRestoration.classList.toggle('active', activeLogo === 'restoration');
      if (logoJanitorial) logoJanitorial.classList.toggle('active', activeLogo === 'janitorial');

      // Determine if navbar CTA should use orange (active Janitorial pill in Hero, OR currently inside Janitorial section)
      let shouldBeOrange = false;
      if (scrollY <= heroHeight - 72) {
        const janitorialPill = document.querySelector('.hero-damage-pill[data-dmg="janitorial"]');
        if (janitorialPill && janitorialPill.classList.contains('is-active')) {
          shouldBeOrange = true;
        }
      } else if (activeLogo === 'janitorial') {
        shouldBeOrange = true;
      }
      document.body.classList.toggle('hero-janitorial-active', shouldBeOrange);
    }

    window.addEventListener('scroll', updateNavbar);
    window.addEventListener('resize', updateNavbar);
    document.addEventListener('DOMContentLoaded', updateNavbar);
    // Extra run to ensure initialization state matches viewport scroll offset on load
    setTimeout(updateNavbar, 100);
  })();

  /* ─── Mobile menu toggle ─── */
  function toggleMenu() {
    const navbar  = document.getElementById('navbar');
    const links   = document.getElementById('nav-links');
    const btn     = document.getElementById('mobile-toggle');
    const isOpen  = navbar.classList.toggle('menu-open');
    links.classList.toggle('open');
    btn.setAttribute('aria-expanded', isOpen);
  }

  /* ─── Smooth-scroll + auto-close ─── */
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function(e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        document.getElementById('navbar').classList.remove('menu-open');
        document.getElementById('nav-links').classList.remove('open');
        document.getElementById('mobile-toggle').setAttribute('aria-expanded', 'false');
        if (target) target.scrollIntoView({ behavior: 'smooth' });
      });
    });

    /* ─── IntersectionObserver for scroll-reveal ─── */
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal, .reveal-up, .reveal-left, .reveal-right').forEach(el => io.observe(el));

    /* ─── Count-up numbers ─── */
    const countIO = new IntersectionObserver((entries, obs) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        const el = entry.target;
        const target = parseInt(el.dataset.target, 10);
        const suffix = el.dataset.suffix || '';
        const formatComma = el.dataset.format === 'comma';
        const dur = 1500;
        const start = performance.now();
        (function tick(now) {
          const p = Math.min((now - start) / dur, 1);
          const val = Math.floor(p * (2 - p) * target);
          el.textContent = (formatComma ? val.toLocaleString() : val) + suffix;
          if (p < 1) requestAnimationFrame(tick);
          else el.textContent = (formatComma ? target.toLocaleString() : target) + suffix;
        })(start);
        obs.unobserve(el);
      });
    }, { threshold: 0.3 });
    document.querySelectorAll('[data-target]').forEach(el => countIO.observe(el));

    /* ─── FAQ accordion ─── */
    document.querySelectorAll('.faq-item').forEach(item => {
      const btn = item.querySelector('.faq-question');
      const body = item.querySelector('.faq-answer');
      if (!btn || !body) return;
      btn.addEventListener('click', () => {
        const open = item.classList.contains('open');
        document.querySelectorAll('.faq-item.open').forEach(i => {
          i.classList.remove('open');
          i.querySelector('.faq-answer').style.maxHeight = null;
        });
        if (!open) {
          item.classList.add('open');
          body.style.maxHeight = body.scrollHeight + 'px';
        }
      });
    });

    /* ─── Reviews slider ─── */
    const track = document.querySelector('.reviews-track');
    const cards = document.querySelectorAll('.review-card');
    const prevBtn = document.querySelector('.reviews-prev');
    const nextBtn = document.querySelector('.reviews-next');
    if (track && cards.length) {
      let idx = 0;
      function getVisible() {
        return window.innerWidth <= 640 ? 1 : window.innerWidth <= 1024 ? 2 : 3;
      }
      function slideTo(n) {
        const vis = getVisible();
        idx = Math.max(0, Math.min(n, cards.length - vis));
        const w = cards[0].getBoundingClientRect().width;
        const gap = parseFloat(getComputedStyle(track).columnGap) || 24;
        track.style.transform = `translateX(-${idx * (w + gap)}px)`;
      }
      if (prevBtn) prevBtn.addEventListener('click', () => slideTo(idx - 1));
      if (nextBtn) nextBtn.addEventListener('click', () => slideTo(idx + 1));
      window.addEventListener('resize', () => slideTo(idx));

      /* Autoplay */
      let auto = setInterval(() => slideTo(idx + 1 > cards.length - getVisible() ? 0 : idx + 1), 5000);
      track.closest('.reviews-slider')?.addEventListener('mouseenter', () => clearInterval(auto));
      track.closest('.reviews-slider')?.addEventListener('mouseleave', () => {
        auto = setInterval(() => slideTo(idx + 1 > cards.length - getVisible() ? 0 : idx + 1), 5000);
      });
    }

    /* ─── Services Accordion + Images sync ─── */
    const firstAccordionItem = document.querySelector('.service-accordion-item');
    if (firstAccordionItem) {
      const firstContent = firstAccordionItem.querySelector('.service-accordion-content');
      if (firstContent) {
        // Timeout to make sure render/reflow occurs before setting initial height
        setTimeout(() => {
          firstContent.style.maxHeight = firstContent.scrollHeight + 'px';
        }, 100);
      }
    }

    document.querySelectorAll('.service-accordion-item').forEach(item => {
      const header = item.querySelector('.service-accordion-header');
      const content = item.querySelector('.service-accordion-content');
      if (!header || !content) return;

      header.addEventListener('click', () => {
        const isActive = item.classList.contains('active');
        if (isActive) return;

        // Close any currently active accordion item
        document.querySelectorAll('.service-accordion-item.active').forEach(activeItem => {
          activeItem.classList.remove('active');
          const activeContent = activeItem.querySelector('.service-accordion-content');
          if (activeContent) {
            activeContent.style.maxHeight = null;
          }
        });

        // Open this accordion item
        item.classList.add('active');
        content.style.maxHeight = content.scrollHeight + 'px';

        // Update active image
        const serviceId = item.dataset.service;
        document.querySelectorAll('.service-image-wrapper').forEach(imgWrap => {
          if (imgWrap.dataset.service === serviceId) {
            imgWrap.classList.add('active');
          } else {
            imgWrap.classList.remove('active');
          }
        });
      });
    });
    /* ─── Pricing Plan Toggle ─── */
    const toggleMonthly = document.getElementById('toggle-monthly');
    const toggleYearly = document.getElementById('toggle-yearly');
    const pricingContainer = document.getElementById('pricing-container');
    
    if (toggleMonthly && toggleYearly && pricingContainer) {
      const monthlyEls = document.querySelectorAll('.price-monthly');
      const yearlyEls = document.querySelectorAll('.price-yearly');
      
      toggleMonthly.addEventListener('click', () => {
        toggleMonthly.classList.add('active');
        toggleYearly.classList.remove('active');
        
        monthlyEls.forEach(el => el.style.display = '');
        yearlyEls.forEach(el => el.style.display = 'none');
      });
      
      toggleYearly.addEventListener('click', () => {
        toggleYearly.classList.add('active');
        toggleMonthly.classList.remove('active');
        
        monthlyEls.forEach(el => el.style.display = 'none');
        yearlyEls.forEach(el => el.style.display = '');
      });
    }
    
    /* ─── Sequential Bounce Reveal for Peace of Mind Speech Bubbles ─── */
    const peaceSection = document.getElementById('peace-of-mind');
    const bubbles = document.querySelectorAll('.bubble-group');
    
    if (peaceSection && bubbles.length) {
      // Setup animationend listener to transition to float loop
      bubbles.forEach(group => {
        group.addEventListener('animationend', (e) => {
          if (e.animationName === 'bubble-bounce') {
            group.classList.remove('bubble-visible');
            group.style.opacity = '0.9';
            group.style.transform = 'scale(1) translateY(0)';
            group.classList.add('float-active');
          }
        });
      });

      let animated = false;
      const peaceObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting && !animated) {
            animated = true;
            peaceObserver.unobserve(peaceSection);
            
            // Pop in Aaron's bubble after a brief delay
            setTimeout(() => {
              const aaronGroup = document.querySelector('.bubble-group-aaron');
              if (aaronGroup) aaronGroup.classList.add('bubble-visible');
            }, 300);
            
            // Pop in Steph's bubble 900ms after
            setTimeout(() => {
              const stephGroup = document.querySelector('.bubble-group-steph');
              if (stephGroup) stephGroup.classList.add('bubble-visible');
            }, 1200);
          }
        });
      }, { threshold: 0.25 });
      
      peaceObserver.observe(peaceSection);
    }

    /* ─── Rentals Mobile Carousel ─── */
    (function initRentalsCarousel() {
      const track    = document.querySelector('.rentals-track');
      const dotsWrap = document.getElementById('rentals-dots');
      const prevBtn  = document.getElementById('rentals-prev');
      const nextBtn  = document.getElementById('rentals-next');
      if (!track || !dotsWrap || !prevBtn || !nextBtn) return;

      const wrapper = track.closest('.rentals-slider-wrap');
      if (!wrapper) return;

      const cards = Array.from(track.querySelectorAll('.rental-card'));
      if (!cards.length) return;

      let idx = 0;

      // Build dots
      cards.forEach((_, i) => {
        const dot = document.createElement('button');
        dot.className = 'rentals-dot' + (i === 0 ? ' active' : '');
        dot.setAttribute('aria-label', 'Go to item ' + (i + 1));
        dot.addEventListener('click', () => slideTo(i));
        dotsWrap.appendChild(dot);
      });

      const dots = Array.from(dotsWrap.querySelectorAll('.rentals-dot'));

      function slideTo(n) {
        if (window.innerWidth > 760) return;
        idx = Math.max(0, Math.min(n, cards.length - 1));
        const card = cards[idx];
        if (card) {
          const scrollLeftTarget = card.offsetLeft - (wrapper.clientWidth - card.clientWidth) / 2;
          wrapper.scrollTo({
            left: scrollLeftTarget,
            behavior: 'smooth'
          });
        }
      }

      function updateActiveState() {
        if (window.innerWidth > 760) return;
        const wrapperRect = wrapper.getBoundingClientRect();
        const wrapperCenter = wrapperRect.left + wrapperRect.width / 2;

        let closestIdx = 0;
        let minDiff = Infinity;

        cards.forEach((card, i) => {
          const cardRect = card.getBoundingClientRect();
          const cardCenter = cardRect.left + cardRect.width / 2;
          const diff = Math.abs(cardCenter - wrapperCenter);
          if (diff < minDiff) {
            minDiff = diff;
            closestIdx = i;
          }
        });

        idx = closestIdx;
        dots.forEach((d, i) => d.classList.toggle('active', i === idx));
        prevBtn.disabled = idx === 0;
        nextBtn.disabled = idx === cards.length - 1;
      }

      prevBtn.addEventListener('click', () => slideTo(idx - 1));
      nextBtn.addEventListener('click', () => slideTo(idx + 1));

      // Synchronize dots and arrows when user swipes natively
      let scrollTimeout;
      wrapper.addEventListener('scroll', () => {
        if (window.innerWidth > 760) return;
        if (scrollTimeout) cancelAnimationFrame(scrollTimeout);
        scrollTimeout = requestAnimationFrame(updateActiveState);
      }, { passive: true });

      // Recalculate on resize (e.g. orientation change)
      window.addEventListener('resize', () => {
        if (window.innerWidth > 760) {
          wrapper.scrollLeft = 0;
          idx = 0;
        } else {
          slideTo(idx);
        }
      });

      // Init
      updateActiveState();
    })();

    /* ─── Deep-linking for services accordion ─── */
    function checkHash() {
      const hash = window.location.hash;
      if (hash && hash.startsWith('#service-')) {
        const item = document.querySelector(hash);
        if (item && !item.classList.contains('active')) {
          const header = item.querySelector('.service-accordion-header');
          if (header) header.click();
        }
      }
    }
    window.addEventListener('hashchange', checkHash);
    window.addEventListener('load', () => setTimeout(checkHash, 300));
    checkHash();
  });
</script>