<!DOCTYPE html>
<html lang="en">
  {% include "component/head.njk" %}
  <body style="display: flex; flex-direction: column; min-height: 100vh;">
      
      <!-- Back Button -->
      <nav style="padding: 40px; position: absolute; top: 0; left: 0; z-index: 1000; width: 100%; pointer-events: none;">
          <a href="/" class="back-link" style="pointer-events: auto; display: inline-flex; align-items: center; gap: 12px; color: var(--primary-color); text-decoration: none; font-family: 'Teodor', var(--font-serif); font-size: 1.25rem; font-weight: 500; transition: all 0.4s cubic-bezier(0.25, 0.1, 0.25, 1);">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="transition: all 0.4s ease;">
                  <line x1="19" y1="12" x2="5" y2="12"></line>
                  <polyline points="12 19 5 12 12 5"></polyline>
              </svg>
              Back
          </a>
      </nav>

      <style>
          :root {
              --white: #ffffff;
              --primary-color: #141414;
              --text-light: #444444;
              --accent-color: #5d22fe;
              --accent-orange: #5d22fe;
          }
          body {
              background-color: var(--white) !important;
              color: var(--text-light) !important;
          }
          h1 {
              font-family: var(--font-display) !important;
              font-size: clamp(2.5rem, 5vw, 4rem) !important;
              font-weight: 400 !important;
              line-height: 1.15 !important;
              letter-spacing: -0.02em !important;
              color: var(--primary-color) !important;
              margin-bottom: 40px !important;
          }
          h2 {
              font-family: var(--font-display) !important;
              font-size: 1.5rem !important;
              font-weight: 400 !important;
              line-height: 1.25 !important;
              letter-spacing: -0.02em !important;
              color: var(--primary-color) !important;
              margin-bottom: 15px !important;
          }
          .policy-gradient-span {
              background: linear-gradient(135deg, #5d22fe, #9e28ff);
              -webkit-background-clip: text;
              -webkit-text-fill-color: transparent;
              background-clip: text;
              display: inline-block;
          }
          .back-link:hover {
              color: var(--accent-color) !important;
              transform: translateX(-8px);
          }
          .back-link:hover svg {
              stroke: var(--accent-color);
          }
      </style>

      <main style="flex-grow: 1;">
      {{ content | safe }}
      </main>

      {% include "component/footer.njk" %}
      {% include "component/scripts.njk" %}
    </body>
</html>
